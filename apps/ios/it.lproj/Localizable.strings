/* ==== POPOPX onboarding v2 (2026-11-19) - the four onboarding screens + privacy policy / terms of use ==== */
/* POPOPX onboarding v2 — generated block, 2026-11-19 */

/* Onboarding: header pills */
"Identity isolation" = "Separazione delle identità";
"Routing & notifications" = "Instradamento e notifiche";
"Commitments & launch" = "Impegni e avvio";

/* Onboarding: page 1 welcome */
"Own your network." = "La tua rete è tua.";
"Private messaging with no account and no user IDs." = "Messaggistica privata senza account e senza ID utente.";
"SMP end-to-end encrypted" = "SMP cifrato end-to-end";
"What POPOPX gives you" = "Cosa ti dà POPOPX";
"No user IDs" = "Nessun ID utente";
"No phone number, no email, no global public key. Nothing links your contacts to each other, and each anonymous identity stays separate." = "Niente numero di telefono, niente email, nessuna chiave pubblica globale. Nulla collega i tuoi contatti tra loro, e ogni identità anonima resta separata.";
"Dynamic relays and near-field" = "Relè dinamici e prossimità";
"Anti-peeping and local-only cards" = "Anti-sguardo e card solo locali";
"Screenshots and recordings are blocked, top-secret messages burn after reading, location stays encrypted in both modes, and your encrypted profile card never leaves this device." = "Screenshot e registrazioni sono bloccati, i messaggi ultra-segreti si autodistruggono dopo la lettura, la posizione resta cifrata in entrambe le modalità e la card del tuo profilo cifrato non lascia mai questo dispositivo.";
"Complete this setup to receive the 3-Day Pioneer Node Trial Badge." = "Completa la configurazione per ricevere il badge di prova di 3 giorni per nodo pioniere.";
"Create encrypted identity" = "Crea identità cifrata";
