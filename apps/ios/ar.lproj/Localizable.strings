"This message was deleted" = "حُذفت هذه الرسالة";
"This message was deleted or not received yet." = "حُذفت هذه الرسالة أو لم تُستلم بعد.";
"This name contains characters POPOPX cannot use." = "يحتوي هذا الاسم على أحرف لا يستطيع POPOPX استخدامها.";
