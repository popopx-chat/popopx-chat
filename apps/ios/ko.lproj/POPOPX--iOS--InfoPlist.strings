"CFBundleName" = "POPOPX";
"NSBluetoothAlwaysUsageDescription" = "POPOPX는 주변의 POPOPX 기기를 찾아내고 인터넷 연결이 없을 때 오프라인으로 메시지를 주고받는 데 Bluetooth를 사용해요.";
"NSCalendarsFullAccessUsageDescription" = "POPOPX는 이 기기에서 캘린더를 읽어 어시스턴트가 언제 시간이 되는지 알 수 있게 하고, \"확인하고 캘린더에 쓰기\"를 탭한 뒤에만 일정을 기록해요. 제목, 위치, 참석자는 빈 시간을 계산하는 데에만 쓰인 뒤 폐기되며, 어떤 정보도 이 기기를 벗어나지 않아요.";
"NSCalendarsUsageDescription" = "POPOPX는 이 기기에서 캘린더를 읽어 어시스턴트가 언제 시간이 되는지 알 수 있게 하고, \"확인하고 캘린더에 쓰기\"를 탭한 뒤에만 일정을 기록해요. 어떤 정보도 이 기기를 벗어나지 않아요.";
"NSCameraUsageDescription" = "POPOPX는 다른 사용자와 연결할 때 QR 코드를 스캔하고 영상 통화를 할 때 카메라를 사용해요.";
"NSFaceIDUsageDescription" = "POPOPX는 인증에 Face ID를 사용해요.";
"NSLocalNetworkUsageDescription" = "POPOPX는 같은 네트워크에 있는 컴퓨터로 채팅 프로필을 사용할 수 있도록 로컬 네트워크 접근을 사용해요.";
"NSLocationWhenInUseUsageDescription" = "채팅에서 위치를 공유하거나 지도 좌표를 직접 지정할 수 있어요. 위치 데이터는 종단간 암호화된 채널로만 전송돼요.";
"NSMicrophoneUsageDescription" = "POPOPX는 음성 및 영상 통화와 음성 메시지 녹음에 마이크를 사용해요.";
"NSNearbyInteractionUsageDescription" = "POPOPX는 직접 만난 상대의 기기와 거리를 측정하기 위해 근거리 상호작용을 사용해요. 그래서 친구 추가는 팔이 닿는 거리에 있을 때만 이뤄져요. 위치 정보는 읽거나 저장하지 않아요.";
"NSPhotoLibraryAddUsageDescription" = "POPOPX는 촬영하거나 받은 사진을 저장하기 위해 사진 보관함 접근을 사용해요.";
