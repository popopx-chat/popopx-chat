<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>development</string>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:popopx.chat</string>
		<string>applinks:www.popopx.chat</string>
		<string>applinks:popopx.chat?mode=developer</string>
		<string>applinks:*.simplex.im</string>
		<string>applinks:*.simplex.im?mode=developer</string>
		<string>applinks:*.popopx.im</string>
		<string>applinks:*.popopx.im?mode=developer</string>
	</array>
	<key>com.apple.developer.networking.multicast</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.popopxchat.popopx</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.popopxchat.popopx</string>
	</array>
</dict>
</plist>
