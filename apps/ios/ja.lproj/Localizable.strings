"Tap to view the copy you sent" = "タップして送信したコピーを表示";
"Tap to view with biometric authentication" = "タップして生体認証で閲覧";
"Tap-and-pass link" = "タップして渡すリンク";
"Text" = "テキスト";
"Text block %lld" = "テキストブロック %lld";
"Text, images and video" = "テキスト・画像・動画";
"That did not complete." = "完了しませんでした。";
