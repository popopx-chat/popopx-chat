[Desktop Entry]
Type=Application
Name=POPOPX Chat
Comment=Privacy-first intelligent connection platform - messenger with no user IDs
Exec=/opt/popopx/bin/popopx %u
Icon=/opt/popopx/lib/popopx
Categories=Network;Chat;
MimeType=x-scheme-handler/popopxchat;x-scheme-handler/simplexchat;x-scheme-handler/popopx;
